# .env.example
# Copier ce fichier en `.env.local` puis renseigner les valeurs.
# Les variables sans préfixe NEXT_PUBLIC sont strictement côté serveur.

# ─────────────────────────────────────────────────────────────
# Site
# ─────────────────────────────────────────────────────────────
# Domaine PRINCIPAL (canonique par défaut, x-default hreflang), avec https://
# et sans slash final. Ex. : https://www.iris-junior-entreprise.com
NEXT_PUBLIC_SITE_URL=https://www.iris-junior-entreprise.com
# Domaines qui REDIRIGENT (308) vers le domaine principal, chemin conservé.
# Par défaut : le .tn. Deux domaines servant le même contenu se concurrencent
# (Google choisit seul le « canonical » et répartit les signaux). Laisser vide
# pour ne rediriger aucun domaine.
NEXT_PUBLIC_REDIRECT_SITE_URLS=https://www.iris-junior-entreprise.tn
# (Avancé) Domaines ALTERNATIFS indexés à part, avec hreflang réciproque
# (ex. .tn → fr-TN / en-TN / ar-TN). À ne renseigner que si vous gardez
# volontairement deux sites indexés. Laisser vide = un seul domaine.
NEXT_PUBLIC_ALTERNATE_SITE_URLS=

# Robots d'entraînement des IA (GPTBot, ClaudeBot, Google-Extended…) : autorisés
# par défaut. Mettre « false » pour les refuser. Les robots de RECHERCHE IA
# (OAI-SearchBot, PerplexityBot, Claude-SearchBot…) restent autorisés : ils
# sont nécessaires pour être cité dans les réponses.
# ALLOW_AI_TRAINING_CRAWLERS=true

# Codes de vérification de propriété (optionnels, balises <meta>) :
# Search Console → « Balise HTML » ; Bing Webmaster Tools → msvalidate.01
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ─────────────────────────────────────────────────────────────
# SMTP — réception des emails de formulaire (contact ET devis)
# Une seule configuration : les deux formulaires arrivent dans la même boîte
# ─────────────────────────────────────────────────────────────

# Hôte SMTP (ex. smtp.hostinger.com, smtp.gmail.com)
MAIL_SMTP_HOST=
# Port SMTP : 465 (SSL/TLS direct) ou 587 (STARTTLS)
MAIL_SMTP_PORT=587
# true si port 465, false si 587
MAIL_SMTP_SECURE=false
# Identifiant SMTP (souvent l'adresse email complète)
MAIL_SMTP_USER=
# Mot de passe SMTP (ou mot de passe d'application pour Gmail/Outlook)
MAIL_SMTP_PASS=
# Expéditeur affiché : "IRIS Junior Entreprise <contact@exemple.com>"
MAIL_FROM=
# Destinataire(s) des demandes de contact et de devis (plusieurs adresses
# séparées par des virgules)
MAIL_TO=iris.juniorentreprise@gmail.com
