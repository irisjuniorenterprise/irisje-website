# .env.example
# Copier ce fichier en `.env.local` puis renseigner les valeurs.
# Les variables sans préfixe NEXT_PUBLIC sont strictement côté serveur.

# ─────────────────────────────────────────────────────────────
# Site
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=

# ─────────────────────────────────────────────────────────────
# SMTP — réception des emails de formulaire (chaque formulaire a
# ses propres variables, on peut donc viser des boîtes distinctes)
# ─────────────────────────────────────────────────────────────

# ── Formulaire Contact (page /contact) ──
# Hôte SMTP (ex. smtp.hostinger.com, smtp.gmail.com)
CONTACT_SMTP_HOST=
# Port SMTP : 465 (SSL/TLS direct) ou 587 (STARTTLS)
CONTACT_SMTP_PORT=587
# true si port 465, false si 587
CONTACT_SMTP_SECURE=false
# Identifiant SMTP (souvent l'adresse email complète)
CONTACT_SMTP_USER=
# Mot de passe SMTP (ou mot de passe d'application pour Gmail/Outlook)
CONTACT_SMTP_PASS=
# Expéditeur affiché : "IRIS Junior Entreprise <contact@exemple.com>"
CONTACT_MAIL_FROM=
# Destinataire(s) des demandes de contact (plusieurs adresses séparées par des virgules)
CONTACT_MAIL_TO=

# ── Formulaire Devis (page /devis) ──
# Hôte SMTP (ex. smtp.hostinger.com, smtp.gmail.com)
DEVIS_SMTP_HOST=
# Port SMTP : 465 (SSL/TLS direct) ou 587 (STARTTLS)
DEVIS_SMTP_PORT=587
# true si port 465, false si 587
DEVIS_SMTP_SECURE=false
# Identifiant SMTP (souvent l'adresse email complète)
DEVIS_SMTP_USER=
# Mot de passe SMTP (ou mot de passe d'application pour Gmail/Outlook)
DEVIS_SMTP_PASS=
# Expéditeur affiché : "IRIS Junior Entreprise <devis@exemple.com>"
DEVIS_MAIL_FROM=
# Destinataire(s) des demandes de devis (plusieurs adresses séparées par des virgules)
DEVIS_MAIL_TO=
